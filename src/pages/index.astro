---
import BaseLayout from '../layouts/BaseLayout.astro';
import Greeting from '../components/Greeting';

const pageTitle = "Home Page";


// The second button works because the client:load directive tells Astro to send and rerun its JavaScript on the client when the page loads, 
// making the component interactive. 
// This is called a hydrated component ->  Greeting client:load messages
---

<BaseLayout pageTitle={pageTitle}>

  <h1> My Astro Site </h1>
  
  
  <Greeting client:load messages={["Hej", "Hallo", "Hola", "Habari"]} />  

</BaseLayout>